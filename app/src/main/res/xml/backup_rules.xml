<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for devices running API 30 and lower.
   See https://developer.android.com/guide/topics/data/autobackup

   Supabase auth tokens (access/refresh) must never leave the device via cloud
   backup. Excluding the auth SharedPreferences prevents session/token
   exfiltration through Google auto-backup. The local owner id
   (dayzero_identity) is intentionally left backed up to aid recovery.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="dayzero_supabase_auth.xml"/>
</full-backup-content>
