<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules for devices running API 31 and higher.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes

   Supabase auth tokens (access/refresh) must never leave the device via cloud
   backup or device-to-device transfer. Excluding the auth SharedPreferences
   prevents session/token exfiltration. The local owner id (dayzero_identity)
   is intentionally left included to aid recovery.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="dayzero_supabase_auth.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="dayzero_supabase_auth.xml"/>
    </device-transfer>
</data-extraction-rules>
