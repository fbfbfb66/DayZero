{
  "name": "@dayzero/ai-gateway",
  "version": "1.0.0",
  "exports": "./src/main.ts",
  "imports": {
    "@dayzero/shared/": "./src/shared/",
    "@dayzero/handlers/": "./src/handlers/",
    "@std/assert": "jsr:@std/assert@1",
    "@std/log": "jsr:@std/log@0.224.5",
    "jose": "jsr:@panva/jose@6"
  },
  "tasks": {
    "start": "deno run --allow-net --allow-env --allow-read src/main.ts",
    "test": "deno test --allow-net --allow-env --allow-read",
    "check": "deno check src/main.ts src/title_worker.ts",
    "lint": "deno lint",
    "fmt": "deno fmt --check"
  },
  "compilerOptions": {
    "strict": true
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "useTabs": false,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "exclude": ["no-explicit-any"]
    }
  }
}
