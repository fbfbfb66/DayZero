# DayZero AI Gateway environment variables.
# Copy to .env and fill in real values. Never commit .env.

PORT=8080

# Environment classification: production | development | test.
# Production requires ENABLE_AUTH=true and will fail-fast otherwise.
APP_ENV=development

# Kimi / Moonshot API configuration.
KIMI_API_URL=https://api.moonshot.cn/v1/chat/completions
KIMI_API_KEY=your-kimi-api-key-here
KIMI_MODEL=kimi-k2.6

# Supabase Auth configuration for JWT verification (production recommended).
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_AUDIENCE=authenticated

# Legacy compatibility: used only when the three variables above are absent.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_JWT_AUDIENCE=authenticated

# CORS and request limits.
# In production, replace * with the actual mobile/Web origins.
ALLOWED_ORIGINS=*
REQUEST_BODY_LIMIT_MB=10

# Logging.
LOG_LEVEL=info

# Set to false only for local development with auth disabled.
# Production always requires true.
ENABLE_AUTH=true
